{
  "name": "@plasius/gpu-world-generator",
  "version": "0.1.1",
  "description": "Deterministic persistent-atlas and voxel world generation with GPU helpers.",
  "type": "module",
  "sideEffects": false,
  "private": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./terrain.wgsl": "./dist/terrain.wgsl",
    "./field.wgsl": "./dist/field.wgsl",
    "./fractal-prepass.wgsl": "./dist/fractal-prepass.wgsl",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && cp src/terrain.wgsl dist/terrain.wgsl && cp src/field.wgsl dist/field.wgsl && cp src/fractal-prepass.wgsl dist/fractal-prepass.wgsl",
    "demo": "python3 -m http.server --directory ..",
    "typecheck": "tsc --noEmit",
    "audit:eslint": "eslint . --max-warnings=0",
    "audit:deps": "npm ls --all --omit=optional --omit=peer > /dev/null 2>&1 || true",
    "audit:npm": "npm audit --audit-level=high --omit=dev",
    "audit:test": "npm run test:coverage",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test",
    "test:coverage": "c8 --reporter=lcov --reporter=text node --test",
    "pack:check": "node scripts/release-changelog.mjs check CHANGELOG.md && npm run privacy:check && node scripts/verify-public-package.cjs",
    "prepublishOnly": "npm run build && npm run pack:check",
    "privacy:check": "node scripts/verify-private-artifacts.cjs",
    "test:privacy": "node --experimental-test-coverage --test-coverage-include=scripts/private-artifact-policy.cjs --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=60 --test tests/private-artifact-policy.test.cjs tests/schema-release.test.cjs"
  },
  "dependencies": {
    "@plasius/asset-contracts": "^0.8.3",
    "@plasius/gpu-fluid": "^0.1.14",
    "@plasius/gpu-shared": "^1.11.2",
    "@plasius/gpu-worker": "^0.3.6"
  },
  "peerDependencies": {
    "@plasius/translations": "^1.0.30"
  },
  "peerDependenciesMeta": {
    "@plasius/translations": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@plasius/translations": "^1.0.30",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "react": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plasius-LTD/gpu-world-generator.git"
  },
  "bugs": {
    "url": "https://github.com/Plasius-LTD/gpu-world-generator/issues"
  },
  "homepage": "https://github.com/Plasius-LTD/gpu-world-generator#readme",
  "overrides": {
    "esbuild": "^0.28.1",
    "minimatch": "^11.0.9",
    "glob": "^14.0.6"
  },
  "engines": {
    "node": ">=24"
  }
}
